DEBUG=True
SECRET_KEY=local-demo-only-change-before-deployment
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PWS: use DEBUG=False and a random SECRET_KEY; set exact public hosts/origins.
# Serve Django admin assets without needing a collectstatic build command.
WHITENOISE_USE_FINDERS=True
# Opt in only for the demo: migrate refreshes the catalog unless reservations exist.
SEED_DEMO_ON_MIGRATE=False
# Optional absolute path on a confirmed persistent volume (parent must exist).
# SQLITE_PATH=/persistent-data/habisin.sqlite3
